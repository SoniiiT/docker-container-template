$TTL 2d

$ORIGIN network.example.com.

@               IN      SOA     ns.network.example.com. example.mail.com (
                                2024052500      ; serial
                                12h             ; refresh
                                15m             ; retry
                                3w              ; expire
                                2h              ; minimum ttl
                                )
                IN      NS      ns.network.example.com.

NS              IN      A       192.168.178.3